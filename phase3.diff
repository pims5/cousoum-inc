+    toggle.textContent = 'Menu';
+    if (returnFocus) toggle.focus();
+  };
   toggle.addEventListener('click', () => {
     const open = nav.classList.toggle('is-open');
     toggle.setAttribute('aria-expanded', String(open));
     toggle.textContent = open ? 'Fermer' : 'Menu';
